# Zalecany tryb dla osób pobierających repo: własne konto, bez płatnego API AI.
MONTAGEFRAMES_ACCOUNT_ONLY=1
QUICKCONTENT_AI_PROVIDER=codex
REEL_DESCRIPTION_PROVIDER=codex
# Dla Claude Code zmień dwa powyższe providery na claude.
# Panel zwykłych rolek i Motion Studio używa Claude Code na koncie.

# Pozostaw puste w trybie konta. API AI wymaga świadomej zmiany trybu.
OPENAI_API_KEY=

# Opcjonalne przebitki LongForm; niezależne od operatora AI.
PEXELS_API_KEY=
